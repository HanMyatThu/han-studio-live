# --- Database (PostgreSQL) ---
# Local: run "docker compose up -d db" and keep this value.
# Server: docker compose sets it for you from POSTGRES_PASSWORD.
DATABASE_URL="postgresql://zat:zat@localhost:5432/zat"
POSTGRES_PASSWORD="zat"

# --- Server ---
# Your domain, for automatic HTTPS (server only).
DOMAIN="example.com"

# --- Auth ---
# Any long random string. Change this in production.
AUTH_SECRET="dev-secret-change-me-please-0123456789abcdef"

# --- Storage ---
# "local" keeps videos in ./storage and streams them from this server.
# "bunny" uploads finished episodes to Bunny Stream (HLS, adaptive quality, CDN).
STORAGE_DRIVER="local"
# Bunny dashboard > Stream > your library > API
BUNNY_STREAM_LIBRARY_ID="mock-library-id"
BUNNY_STREAM_API_KEY="mock-bunny-api-key"
BUNNY_STREAM_CDN_URL="https://vz-xxxxxxxx-xxx.b-cdn.net"
# Bunny dashboard > Stream > your library > Security > Token Authentication key
BUNNY_TOKEN_KEY="mock"

# --- AI: transcription + translation ---
# Leave as "mock" to use the built-in mock (no network). Set real keys to go live.
OPENAI_API_KEY="mock"
TRANSLATION_PROVIDER="mock"   # mock | openai | gemini
OPENAI_TRANSLATE_MODEL="gpt-5.4-mini"   # used when TRANSLATION_PROVIDER="openai"
GEMINI_MODEL="gemini-2.5-flash"         # used when TRANSLATION_PROVIDER="gemini"
GEMINI_API_KEY="mock"

# --- Payments ---
PAYMENT_PROVIDER="mock"       # mock | dinger | 2c2p (only mock is implemented)
DINGER_API_KEY="mock"

# --- Ads ---
# Leave empty to show placeholder ad slots.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_IMA_AD_TAG_URL=""

# --- Admin account ---
# Used by "npm run db:seed" (local demo) and "npm run db:init" (server). Use a strong password on the server.
ADMIN_EMAIL="admin@zat.local"
ADMIN_PASSWORD="admin1234"
